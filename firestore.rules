rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isInstructor() {
      return signedIn() && userProfile().data.role == 'instructor';
    }

    function isLectureOwner() {
      return signedIn() && resource.data.instructorId == request.auth.uid;
    }

    function isCreatingOwnLecture() {
      return isInstructor() && request.resource.data.instructorId == request.auth.uid;
    }

    function isStudentAttendanceSummaryUpdate() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return signedIn()
        && changedKeys.hasOnly(['attendanceCount', 'status'])
        && request.resource.data.status == 'live'
        && request.resource.data.attendanceCount is int
        && request.resource.data.attendanceCount >= resource.data.attendanceCount;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /{path=**}/attendance/{studentId} {
      allow read: if signedIn();
    }

    match /lectures/{lectureId} {
      allow read: if signedIn();
      allow create: if isCreatingOwnLecture();
      allow update: if isLectureOwner() || isStudentAttendanceSummaryUpdate();
      allow delete: if false;

      match /attendance/{studentId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == studentId
          && request.resource.data.id == request.auth.uid;
        allow delete: if false;
      }
    }
  }
}
